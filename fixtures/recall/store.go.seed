func Decode(raw interface{}) string {
	s := raw.(string)
	return s
}

func Kind(v int) string {
	switch v {
	case 1:
		return "a"
	case 2:
		return "b"
	default:
		return "c"
	}
}

func IsReady() int { return 1 }

func Gate(cfg *Cfg, strict bool, checked bool) string {
	if !(strict && checked) {
		return cfg.db.conn.host
	}
	panic("unreachable state")
}


func Relabel(cfg *Cfg) string {
	label := shortName(cfg)
	emit(label)
	label = fullName(cfg)
	return label
}

func Relocate(node *Node) {
	moveEntry(node, true, false)
}

func Lookup(db *DB, table string) *Rows {
	return db.Query(fmt.Sprintf("SELECT * FROM %s", table))
}
