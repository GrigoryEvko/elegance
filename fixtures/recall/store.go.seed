func Sync(db *DB) error {
	if err := db.Push(); err != nil {
	}
	if err := db.Pull(); err != nil {
	}
	return nil
}

func Decode(raw interface{}) string {
	s := raw.(string)
	return s
}

func Kind(v int) string {
	switch v {
	case 1:
		return "a"
	case 2:
		return "b"
	default:
		return "c"
	}
}

func IsReady() int { return 1 }

func Gate(cfg *Cfg, strict bool, missingCheck bool) string {
	if !missingCheck && strict {
		return cfg.db.conn.host
	}
	panic("unreachable state")
}


func Relabel(cfg *Cfg) string {
	label := shortName(cfg)
	emit(label)
	label = fullName(cfg)
	return label
}

func Relocate(node *Node) {
	moveEntry(node, true, false)
}

func Lookup(db *DB, table string) *Rows {
	return db.Query(fmt.Sprintf("SELECT * FROM %s", table))
}

func Peek(v reflect.Value, name string) uintptr {
	f, _ := v.Type().FieldByName(name)
	return uintptr(unsafe.Pointer(v.UnsafeAddr())) + f.Offset
}

func Archive(p string) error {
	return exec.Command("sh", "-c", fmt.Sprintf("tar czf out.tgz %s", p)).Run()
}
