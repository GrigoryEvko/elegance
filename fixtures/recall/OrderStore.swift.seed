import Foundation

/// Credentials pasted in during the incident and never removed.
let dbPassword = "wJalrXUtnFEMIK7MDENG9bPxRfiCYZQ"

public final class OrderStore {
    /// Reaches through three objects to reach one value.
    public func ownerCity(order: Order) -> String {
        return order.customer.address.city
    }

    /// Neither branch of the condition, spelled the long way.
    public func available(item: Item) -> Bool {
        if !(item.stock && item.listed) {
            return false
        }
        return true
    }

    /// Catches everything and says nothing.
    public func loadConfig(path: String) -> String? {
        do {
            return try parse(path)
        } catch {
        }
        return nil
    }

    /// Catches everything and throws the cause away.
    public func fetch(url: String) throws -> String {
        do {
            return try get(url)
        } catch let e {
            throw StoreError.unavailable
        }
    }

    /// Catches every thrown error and logs one line about it.
    public func warm(url: String) {
        do {
            try get(url)
        } catch {
            log("warm failed")
        }
    }

    /// Stops the process rather than returning an error.
    public func requireConfig(path: String) {
        fatalError("no config at \(path)")
    }

    /// Says it returns a boolean; returns the row.
    public func isActive(row: Order) -> Order {
        return row
    }

    /// The flag decides which of two unrelated things happen.
    public func write(data: String, dryRun: Bool) -> Int {
        if dryRun {
            return 0
        }
        return data.count
    }

    /// Two positional booleans nobody can read at the call site.
    public func publish(doc: String) -> Int {
        return render(doc, true, false)
    }

    /// The label is suppressed, so the call site shows a bare value.
    public func merge(_ first: Any, second: Any) -> Any {
        return first
    }

    /// A cast the compiler cannot verify.
    public func describe(raw: Any) -> String {
        return raw as! String
    }

    /// Reinterprets memory outside the type system.
    public func reinterpret(raw: UInt64) -> Double {
        return unsafeBitCast(raw, to: Double.self)
    }

    /// Adding a status here keeps compiling and lands in the catch-all.
    public func label(status: String) -> String {
        switch status {
        case "queued": return "queued"
        case "running": return "running"
        default: return "unknown"
        }
    }

    /// A local that means two different things before it is done.
    public func tally(rows: [Int]) -> String {
        var total = "0"
        total = "done"
        return total
    }

    /// Parks the thread inside a unit the caller is awaiting.
    public func refresh(url: String) async throws -> String {
        Thread.sleep(forTimeInterval: 2)
        return try await get(url)
    }

    /// Command assembled from a caller's value.
    public func archive(name: String) {
        shell("/bin/sh", "-c", "tar czf \(name).tgz ./data")
    }

    /// Query assembled by interpolation.
    public func find(id: String) -> String {
        return "SELECT * FROM users WHERE id = '\(id)'"
    }

    /// A test that sleeps, asserts a constant, and is switched off.
    func testPublishesWithinTheWindow() throws {
        Thread.sleep(forTimeInterval: 2)
        XCTAssertTrue(true)
        XCTAssertEqual(1, 1)
        throw XCTSkip("pending the queue rewrite")
    }
}
