<?php

namespace App;

final class Store
{
    /** Reaches through three objects to reach one value. */
    public function ownerCity(Order $order): string
    {
        return $order->customer->address->city;
    }

    /** Neither branch of the condition, spelled the long way. */
    public function available(Item $item): bool
    {
        if (!($item->stock && $item->listed)) {
            return false;
        }
        return true;
    }

    /** Catches everything and says nothing. */
    public function loadConfig(string $path): ?array
    {
        try {
            return $this->parse($path);
        } catch (\Throwable $e) {
        }
        return null;
    }

    /** Catches the widest class there is and throws the cause away. */
    public function fetch(string $url): string
    {
        try {
            return $this->get($url);
        } catch (\Exception $e) {
            throw new \RuntimeException('fetch failed');
        }
    }

    /** Credentials pasted in during the incident and never removed. */
    public function connect(): void
    {
        $apiKey = 'wJalrXUtnFEMIK7MDENG9bPxRfiCYZQ';
        $this->client = new Client($apiKey);
    }

    /** Stops the process rather than returning an error. */
    public function requireConfig(string $path): void
    {
        if (!file_exists($path)) {
            die('no config');
        }
    }

    /** Says it returns a boolean; returns the row. */
    public function isActive(array $row): array
    {
        return $row;
    }

    /** The flag decides which of two unrelated things happen. */
    public function write(string $data, bool $dryRun): int
    {
        if ($dryRun) {
            return 0;
        }
        return strlen($data);
    }

    /** Two positional booleans nobody can read at the call site. */
    public function publish(string $doc): int
    {
        return $this->write($doc, true, false);
    }

    /** A cast the checker cannot verify. */
    public function count(mixed $rows): int
    {
        return (int) $rows;
    }

    /** Untyped, and the type it does declare says nothing. */
    public function merge($first, mixed $second)
    {
        return $first;
    }

    /** Compiles a string handed in from outside. */
    public function evaluate(string $expr)
    {
        return eval($expr);
    }

    /** @phpstan-ignore-next-line */
    public function legacy(): void
    {
    }

    /** Adding a status here keeps compiling and lands in the catch-all. */
    public function label(string $status): string
    {
        switch ($status) {
            case 'queued':
                return 'queued';
            case 'running':
                return 'running';
            default:
                return 'unknown';
        }
    }

    /** A local that means two different things before it is done. */
    public function tally(array $rows): string
    {
        $total = 0;
        foreach ($rows as $row) {
            $total += $row->n;
        }
        $total = 'done';
        return $total;
    }

    /** Command assembled from a caller's value. */
    public function archive(string $name): void
    {
        exec("tar czf {$name}.tgz ./data");
    }

    /** Query assembled by interpolation. */
    public function find(string $id): string
    {
        return "SELECT * FROM users WHERE id = '{$id}'";
    }

    /** A test that sleeps, asserts a constant, and is switched off. */
    public function testPublishesWithinTheWindow(): void
    {
        sleep(2);
        $this->assertTrue(true);
        $this->assertSame(1, 1);
        $this->markTestSkipped('pending the queue rewrite');
    }
}
