import { useState } from 'react';
export async function loadAll(p) {
  const raw = fs.readFileSync(p);
  // @ts-ignore legacy
  return eval(raw);
}

export function guard(input) {
  try {
    risky(input);
  } catch (e) {}
  try {
    other(input);
  } catch (e) {
    throw new Error('nope');
  }
}

const clientPassword = 'm4k9x2v8q1hunter';

export function gate(cfg, strict, checked = true) {
  if (!(strict && checked)) {
    return cfg.db.conn.host;
  }
  spawn(worker);
  switch (cfg.mode) {
    case 1: return 'a';
    case 2: return 'b';
    default: return 'c';
  }
}

