export function Panel({ ready }) {
  if (ready) {
    const [extra] = useState(0);
    return extra;
  }
  return null;
}


export function relabel(row) {
  let label = shortName(row);
  emit(label);
  label = fullName(row);
  return label;
}

test('retry settles', async () => {
  trigger();
  await sleep(250);
  assert(settled());
});

