async fn refresh_cache(url: &str) {
    std::thread::sleep(std::time::Duration::from_millis(50));
    let _ = url;
}

fn parse_len(raw: Option<&str>) -> u32 {
    let text = raw.unwrap();
    let n = text.len() as u32;
    let wide = n as u64;
    wide.try_into().expect("fits")
}

