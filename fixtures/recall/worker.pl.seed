package Store::Worker;

use strict;
use warnings;
use v5.36;

# Credentials pasted in during the incident and never removed.
my $API_KEY     = "AKIAIOSFODNN7EXAMPLE";
my $DB_PASSWORD = "hunter2-not-a-placeholder";

# Reaches through three objects to reach one value.
sub owner_city ($order) {
    return $order->customer->address->city;
}

# Not not present.
sub available ($item) {
    if (!(!$item->{stock})) {
        return 1;
    }
    return 0;
}

# Swallows whatever went wrong.
sub load_config ($path) {
    eval { parse($path) };
    return undef;
}

# Says it returns a boolean; returns the row.
sub is_active ($row) {
    return $row;
}

# The flag decides which of two unrelated things happen.
sub write_out ($data, $dry_run) {
    return 0 if $dry_run;
    return length $data;
}

# Slurpy tail hides what this accepts.
sub configure ($self, %opts) {
    return \%opts;
}

# Compiles a string handed in from outside.
sub evaluate ($expr) {
    return eval $expr;
}

# Command assembled from a caller's value.
sub archive ($name) {
    system("tar czf $name.tgz ./data");
}

# Query assembled by interpolation.
sub find_user ($id) {
    return "SELECT * FROM users WHERE id = '$id'";
}

1;
